    spawn-at-startup "Telegram"
    spawn-at-startup "brave-origin"
    spawn-at-startup "remmina"
    spawn-at-startup "obsidian"
    spawn-at-startup "zeditor"

    // Telegram
    workspace "telegram"
    window-rule {
        match app-id="org.telegram.desktop"
        open-on-workspace "telegram"
        open-maximized true
    }

    // Firefox
    workspace "browser"
    window-rule {
        match app-id="firefox"
        open-on-workspace "browser"
        open-maximized true
    }

    // Brave
    window-rule {
        match app-id="brave-origin"
        open-on-workspace "browser"
        open-maximized true
    }

    // Remmina
    workspace "remmina"
    window-rule {
        match title="Remmina Remote Desktop Client"
        open-on-workspace "remmina"
        open-maximized true
    }

    workspace "wisdom"
    // Obsidian
    window-rule {
        match app-id="obsidian"
        open-maximized true
        open-on-workspace "wisdom"
    }

    workspace "IDE"
    // Zed
    window-rule {
        match app-id="Zed"
        open-on-workspace "IDE"
        open-maximized true
    }
